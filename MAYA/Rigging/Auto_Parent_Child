import maya.cmds as cmds
import re


def get_ctrl_pairs(selection):
    """
    Parse selected objects into (number, group_short, ctrl_short) tuples.
    Stores short names instead of long paths to avoid stale path issues
    after reparenting. Assumes unique short names across the hierarchy.
    Handles selection of groups, controllers, or a mix of both.
    """
    pairs = []

    for item in selection:
        short_name = item.split('|')[-1]

        # Extract the first numeric token from the name
        match = re.search(r'(\d+)', short_name)
        if not match:
            cmds.warning('Cannot extract number from "{}", skipped.'.format(short_name))
            continue
        num = int(match.group(1))

        # Determine whether the selected item is a group or a controller
        children = cmds.listRelatives(item, children=True, type='transform', fullPath=True) or []

        if '_grp' in short_name.lower():
            # Selected item is a group -> find its child controller
            ctrl = None
            for ch in children:
                ch_short = ch.split('|')[-1]
                if '_grp' not in ch_short.lower():
                    ctrl = ch
                    break
            # Fallback: use the first child if no non-group child found
            if ctrl is None and children:
                ctrl = children[0]
            if ctrl is None:
                cmds.warning('"{}" has no child controller, skipped.'.format(short_name))
                continue
            # Store short names to survive reparenting
            pairs.append((num, short_name, ctrl.split('|')[-1]))
        else:
            # Selected item is a controller -> find its parent group
            parents = cmds.listRelatives(item, parent=True, fullPath=True)
            if not parents:
                cmds.warning('"{}" has no parent group, skipped.'.format(short_name))
                continue
            parent_grp = parents[0]
            parent_short = parent_grp.split('|')[-1]
            if '_grp' not in parent_short.lower():
                cmds.warning('Parent of "{}" is not a group, skipped.'.format(short_name))
                continue
            pairs.append((num, parent_short, short_name))

    return pairs


def chain_controls():
    """Main execution: sort pairs by number and parent each grp under the previous ctrl."""
    sel = cmds.ls(selection=True, long=True)
    if not sel:
        cmds.warning('Please select controller groups or controllers first.')
        return

    pairs = get_ctrl_pairs(sel)

    if len(pairs) < 2:
        cmds.warning('Less than 2 valid pairs found. Cannot build chain.')
        return

    # Sort ascending by number (01 is the outermost)
    pairs.sort(key=lambda x: x[0])

    # Deduplicate in case user selected both group and controller
    seen = set()
    unique_pairs = []
    for num, grp, ctrl in pairs:
        key = (grp, ctrl)
        if key not in seen:
            seen.add(key)
            unique_pairs.append((num, grp, ctrl))
    pairs = unique_pairs

    if len(pairs) < 2:
        cmds.warning('Less than 2 unique pairs after deduplication.')
        return

    # Parent each grp (from index 1 onward) under the previous ctrl.
    # Short names are used so paths remain valid after reparenting.
    cmds.undoInfo(openChunk=True, chunkName='ChainCtrls')
    try:
        for i in range(1, len(pairs)):
            prev_ctrl = pairs[i - 1][2]
            curr_grp = pairs[i][1]
            cmds.parent(curr_grp, prev_ctrl)
            print('  {}  ->  {}'.format(curr_grp, prev_ctrl))
    except Exception as e:
        cmds.undo()
        cmds.error('Chaining failed, undone: {}'.format(e))
    finally:
        cmds.undoInfo(closeChunk=True)

    # Select the root group for easy inspection
    cmds.select(pairs[0][1], replace=True)
    cmds.inViewMessage(
        amg='<span style="color:#88ff88;">Chain complete ({} levels)</span>'.format(len(pairs)),
        pos='midCenter', fade=True, fadeStayTime=1500
    )
    print('===== Chain complete: {} levels ====='.format(len(pairs)))


# Execute directly
chain_controls()
